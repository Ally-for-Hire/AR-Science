{
  "expo": {
    "name": "AR Science",
    "slug": "ar-science-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arscience",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibetribe.arscience"
    },
    "android": {
      "package": "com.vibetribe.arscience",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          },
          "ios": {
            "cameraUsagePermission": "AR Science uses your camera to place 3D models in your space.",
            "microphoneUsagePermission": "Starter Kit uses your microphone for AR experiences.",
            "photosPermission": "Starter Kit would like to read photos for AR experiences.",
            "savePhotosPermission": "Starter Kit would like to save photos to your library during AR experiences."
          },
          "googleCloudApiKey": "Your Google Cloud API Key",
          "provider": "reactvision",
          "rvApiKey": "Add your API key here",
          "rvProjectId": "Add your project ID here"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6afb9e7-1c39-456c-99a8-436e8c3a1619"
      }
    }
  }
}
